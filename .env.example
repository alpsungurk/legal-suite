# Hata izleme (Sentry). Boş bırakılırsa kapalıdır.
# Sentry'de "React" projesi oluşturup DSN'i buraya yazın.
VITE_SENTRY_DSN=
# İsteğe bağlı: hatanın hangi sürümden geldiğini gösterir (ör. git commit kısaltması)
VITE_SENTRY_RELEASE=

# Demo büro (örnek veri). Canlıda boş bırakın.
VITE_DEMO=

# Veritabanı (Supabase) — Project Settings > API
# service_role anahtarı ASLA buraya / istemciye konmaz (yalnızca Edge Function'da).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
